diil/imperial-city/white-gold-tower\" class=\"entity-link\">\n            White-Gold Tower\n        </a>\n    </h3>\n\n                    <p>Cyrodiil is connected to White-Gold Tower through shared lore.</p>\n\n                    \n\n                    \n                </div>\n            \n                <div class=\"fact-card\">\n                    <div class=\"fact-label\">\n                        Connected To\n                    </div>\n\n                    <h3>\n        <a href=\"/elder-scrolls/septim-empire\" class=\"entity-link\">\n            Septim Empire\n        </a>\n    </h3>\n\n                    <p>Cyrodiil is connected to Septim Empire through shared lore.</p>\n\n                    \n\n                    \n                </div>\n            \n        </div>\n    </details>\n</section>\n\n<section class=\"topic-section\">\n    <details>\n        <summary class=\"topic-summary\">\n            <span class=\"topic-title\">Contains</span>\n            <span class=\"topic-count\">2</span>\n        </summary>\n\n        \n        <div class=\"topic-examples\">\n            \n                <a\n                    href=\"/elder-scrolls/nirn/tamriel/cyrodiil/imperial-city\"\n                    class=\"connection\"\n                    data-relationship=\"Contains\"\n                >\n                    <strong>Imperial City</strong>\n                    <span>Capital of Cyrodiil on Lake Rumare.</span>\n                </a>\n            \n                <a\n                    href=\"/elder-scrolls/elder-scrolls-iv-oblivion\"\n                    class=\"connection\"\n                    data-relationship=\"Contains\"\n                >\n                    <strong>The Elder Scrolls IV: Oblivion</strong>\n                    <span>2006 RPG of the Oblivion Crisis.</span>\n                </a>\n            \n        </div>\n        \n\n        <div class=\"topic-content\">\n            \n                <div class=\"fact-card\">\n              