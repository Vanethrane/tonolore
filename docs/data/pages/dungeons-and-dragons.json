s-dragons\" class=\"entity-link\">\n            Advanced Dungeons &amp; Dragons\n        </a>\n    </h3>\n\n                    <p>AD&amp;D is a major historical edition.</p>\n\n                    \n\n                    \n                </div>\n            \n                <div class=\"fact-card\">\n                    <div class=\"fact-label\">\n                        Contains\n                    </div>\n\n                    <h3>\n        <a href=\"/dungeons-and-dragons/greyhawk\" class=\"entity-link\">\n            Greyhawk\n        </a>\n    </h3>\n\n                    <p>Greyhawk is a classic D&amp;D setting.</p>\n\n                    \n\n                    \n                </div>\n            \n                <div class=\"fact-card\">\n                    <div class=\"fact-label\">\n                        Contains\n                    </div>\n\n                    <h3>\n        <a href=\"/dungeons-and-dragons/dragonlance\" class=\"entity-link\">\n            Dragonlance\n        </a>\n    </h3>\n\n                    <p>Dragonlance is an official D&amp;D setting.</p>\n\n                    \n\n                    \n                </div>\n            \n                <div class=\"fact-card\">\n                    <div class=\"fact-label\">\n                        Contains\n                    </div>\n\n                    <h3>\n        <a href=\"/dungeons-and-dragons/ravenloft\" class=\"entity-link\">\n            Ravenloft\n        </a>\n    </h3>\n\n                    <p>Ravenloft is D&amp;D&#039;s horror setting.</p>\n\n                    \n\n                    \n                </div>\n            \n                <div class=\"fact-card\">\n                    <div class=\"fact-label\">\n                        Contains\n                    </div>\n\n                    <h3>\n        <a href=\"/dungeons-and-dragons/alignment-system\" class=\"entity-link\">\n            Alignment\n        </a>\n    </h3>\n\n                    <p>Alignment